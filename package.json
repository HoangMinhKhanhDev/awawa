{
  "name": "on-luyen-hsg",
  "version": "0.1.0",
  "description": "On luyen hoc sinh gioi THPT - React PWA + PHP/MySQL",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "npm run build:renderer",
    "build:web": "vite build",
    "build:renderer": "vite build && node scripts/copy-api.cjs",
    "preview": "vite preview",
    "db:migrate:status": "php database/bin/migrate.php status",
    "db:migrate": "php database/bin/migrate.php migrate",
    "db:migrate:rollback": "php database/bin/migrate.php rollback-last",
    "test:migration:contract": "php tests/php/migration_contract.php",
    "test:migration:db": "php tests/php/migration_db.php",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.0.0",
    "php-parser": "^3.7.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  }
}
