# Copy thành .env (local) hoặc nhập vào Vercel → Project → Settings → Environment Variables.
# Lấy 2 giá trị này ở Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Chế độ Hostinger (PHP + MySQL), dùng THAY cho Supabase ---
# Trỏ tới thư mục api/ đã upload lên hosting (giữ nguyên /api ở cuối).
# VD: VITE_API_BASE=https://herbspalab.com/api
# VITE_API_BASE=
# Token phải trùng với API_TOKEN trong Environment variables của hosting.
# VITE_API_TOKEN=
