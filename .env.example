# Copy thành .env local hoặc nhập VITE_API_BASE trong hPanel.
# Giữ nguyên /api ở cuối.
# VD: VITE_API_BASE=https://herbspalab.com/api
VITE_API_BASE=
AWAWA_MIGRATIONS_REQUIRED=1
AWAWA_STRICT_TENANT=1
AWAWA_MIGRATION_DEFAULT_SCHOOL_SLUG=thuong-cho
AWAWA_MIGRATION_DEFAULT_SCHOOL_NAME=Trường Chở
AWAWA_MIGRATION_DEFAULT_SCHOOL_CODE=
AWAWA_MIGRATION_DEFAULT_SCHOOL_TIMEZONE=Asia/Ho_Chi_Minh
AWAWA_MIGRATION_ASSIGN_SINGLE_SCHOOL=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_NAME=awawa
DB_USER=awawa
DB_PASS=
API_TOKEN=
